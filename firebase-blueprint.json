{
  "entities": {
    "Prompt": {
      "title": "Prompt",
      "description": "An AI prompt stored in the prompt warehouse.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Prompt title",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "description": "Prompt category",
          "enum": ["사진 합성", "스타일 변환", "캐릭터·포스터"],
          "minLength": 1,
          "maxLength": 40
        },
        "content": {
          "type": "string",
          "description": "Full multi-line prompt content (up to 10,000 characters)",
          "minLength": 1,
          "maxLength": 10000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the prompt was created"
        }
      },
      "required": ["title", "category", "content", "createdAt"]
    }
  },
  "firestore": {
    "/prompts/{promptId}": {
      "schema": { "$ref": "#/entities/Prompt" },
      "description": "Collection of AI prompts readable by anyone and writable only by the verified admin"
    }
  }
}
